name:               leoconforti-us
version:            0.0.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  build-depends:    base == 4.*
                  , hakyll == 4.17.*
                  , clay
                  , mtl
                  , bytestring
                  , containers
                  , text
                  , time
                  , yaml
                  , blaze-html
                  , skylighting
                  , pandoc
                  , hakyll-images
                  , filepath
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
