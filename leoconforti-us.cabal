name:               leoconforti-us
version:            0.0.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  -- Bounds are set on Hackage packages only; the rest are GHC boot
  -- libraries whose versions are fixed by the compiler.
  build-depends:    base >=4 && <5
                  , hakyll >=4.17 && <4.18
                  , clay >=0.16 && <0.17
                  , mtl
                  , bytestring
                  , containers
                  , text
                  , time
                  , yaml >=0.11 && <0.12
                  , blaze-html >=0.9 && <0.10
                  , skylighting >=0.14 && <0.15
                  , pandoc >=3.10 && <3.11
                  , hakyll-images >=1.3 && <1.4
                  , filepath
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
