name:               leoconforti-us
version:            0.0.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  -- Bounds are set on Hackage packages only; the rest are GHC boot
  -- libraries whose versions are fixed by the compiler.
  build-depends:    base == 4.*
                  , hakyll == 4.17.*
                  , clay == 0.16.*
                  , mtl
                  , bytestring
                  , containers
                  , text
                  , time
                  , yaml == 0.11.*
                  , blaze-html == 0.9.*
                  , skylighting == 0.14.*
                  , pandoc == 3.10.*
                  , hakyll-images == 1.3.*
                  , filepath
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
